rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Acesso permitido somente para usuários autenticados no Firebase Auth.
    // Antes desta regra, o banco aceitava leitura e exclusão anônimas
    // (apenas com a API key pública do app).
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
